{
  "name": "sauron-ai",
  "version": "3.2.0",
  "description": "Universal AI agent orchestrator and harness for 20 AI coding runtimes.",
  "type": "module",
  "main": "./dist/adapters/transpiler.js",
  "bin": {
    "sauron": "./bin/sauron.mjs",
    "sauron-ai": "./bin/sauron.mjs"
  },
  "files": [
    "licenses",
    "bin",
    "dist",
    "config",
    "core",
    "rules",
    "skills",
    "references",
    "docs",
    "!docs/handoffs",
    "!docs/sauron-second-brain",
    "commands",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node ./bin/sauron.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "check-docs": "node ./scripts/hooks/check-docs.mjs",
    "security-scan": "node ./scripts/security/security-scan.mjs",
    "ingest-skills": "node ./scripts/skills/ingest-skills.mjs",
    "prepare": "husky",
    "release:patch": "npm test && npm run check-docs && npm run build && npm version patch && npm publish && git push origin main --tags",
    "release:minor": "npm test && npm run check-docs && npm run build && npm version minor && npm publish && git push origin main --tags",
    "release:major": "npm test && npm run check-docs && npm run build && npm version major && npm publish && git push origin main --tags"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "cursor",
    "windsurf",
    "cline",
    "copilot",
    "harness",
    "skills",
    "fellowship",
    "sauron"
  ],
  "author": "sauron contributors",
  "license": "(MIT OR Apache-2.0 OR Unlicense)",
  "homepage": "https://sauron-cli.vercel.app",
  "bugs": {
    "url": "https://github.com/iging/sauron/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iging/sauron.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "chalk": "^6.0.1",
    "commander": "^12.1.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
