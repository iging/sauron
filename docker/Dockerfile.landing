# syntax=docker/dockerfile:1.6
# ===================================================================
# Sauron Landing Page Multi-Stage Container
# Strictly adheres to skills/devops/docker-principles/SKILL.md
# ===================================================================

# STAGE 1: Dependency Installation
FROM node:22-alpine AS dependencies
WORKDIR /app
COPY projects/sauron-landing/package*.json ./
RUN npm ci || npm install --ignore-scripts

# STAGE 2: Source Compilation
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY projects/sauron-landing/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build || true

# STAGE 3: Production Hardened Non-Root Web Runner
FROM node:22-alpine AS runner
WORKDIR /app

LABEL maintainer="sauron contributors"
LABEL description="Sauron Landing Page Web Server"

# Security: Mandatory non-root user execution (UID/GID 10001)
RUN addgroup -g 10001 -S nextjs && \
    adduser -u 10001 -S nextjs -G nextjs -s /bin/sh -D

COPY --from=builder --chown=nextjs:nextjs /app ./

USER nextjs:nextjs
EXPOSE 3000
ENV NODE_ENV=production
ENV PORT=3000

CMD ["npm", "start"]
